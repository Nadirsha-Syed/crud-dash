<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Edit Post</title>
    <link rel="stylesheet" href="/style.css">
</head>
<body>
    <div class="container">
        <h2>Edit your post</h2>
        
        <div class="post">
            <p class="meta-info">ID: <%= post.id %></p>
            <p class="user">Username: @<%= post.username %></p>
            
            <form method="post" action="/posts/<%= post.id %>?_method=PATCH">
                <textarea name="content" rows="5" placeholder="Write your content..."><%= post.content %></textarea>
                <div class="form-footer">
                    <button type="submit" class="submit-btn">Update Post</button>
                    <a href="/posts" class="cancel-link">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</body>
</html>