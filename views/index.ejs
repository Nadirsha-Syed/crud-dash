<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>All Posts</title>
    <link rel="stylesheet" href="/style.css">
</head>
<body>
    <div class="container">
        <h1>CRUD <span>Dash</span></h1>
        <br>
        
        <% for(post of posts) { %>
            <div class="post">
                <h3 class="user">@ <%= post.username %></h3>
                <p class="content"><%= post.content %></p>
                
                <div class="post-actions">
                    <a href="/posts/<%= post.id %>">View details</a>
                    
                    <form method="get" action="/posts/<%= post.id %>/edit" style="display:inline;">
                        <button type="submit">Edit</button>
                    </form>
                    
                    <form method="post" action="/posts/<%= post.id %>?_method=DELETE" style="display:inline;">
                        <button id="del-btn" type="submit">Delete</button>
                    </form> </div>
            </div>
        <% } %>

        <br>
        <a href="/posts/new" class="create-link">Create a new post</a>
    </div>
</body>
</html>